{
  "name": "lightreader",
  "version": "1.0.0",
  "description": "轻量级在线EPUB电子书阅读器",
  "main": "index.html",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/regression-checks.js && node tests/zip-safety.test.js",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "check": "npm run test",
    "audit": "npm audit --audit-level=high --registry=https://registry.npmjs.org",
    "build": "npm run check && echo '构建静态资源完成'",
    "clean": "echo '清理完成'",
    "copy-files": "echo '文件复制完成'",
    "minify-css": "echo 'CSS 压缩完成'",
    "minify-js": "echo 'JS 压缩完成'"
  },
  "keywords": [
    "epub",
    "reader",
    "ebook",
    "web",
    "pwa"
  ],
  "author": "Yvonne",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "http-server": "^14.1.1",
    "jszip": "^3.10.1"
  }
}
